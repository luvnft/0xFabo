---
import ContentSection from "~/components/content-section.astro";
import type { ServiceItem } from "~/types";
import FeaturesList from "~/components/features-list.astro";

const services: Array<ServiceItem> = [
  { 
    title: "W3W", 
    subtitle: "MARKET", 
    description: "We're tokenizing all of the 510 trillion unique What3Words addresses as W3W properties.", 
    img: "socialMedia", 
    emoji: "🌍", // Unique emoji for this service
  },
  { 
    title: "3 Words", 
    subtitle: "K.I.S.S", 
    description: "Sharing 3 word addresses shows that you keep it simple, owning 3 word addresses as a Bitcoin W3W shows the world you're smart.", 
    img: "branding", 
    emoji: "💬", // Unique emoji for this service
  },
  {
    title: "SELL",
    subtitle: "BAG",
    description: "Sell your W3W attached or detached from a physical RWA with no middleman in the CRE CLUB marketplace and earn Bitcoin",
    img: "grMkt",
    emoji: "💰", // Unique emoji for this service
  },
  { 
    title: "AD",
    subtitle: "SHOP",
    description: "Create a W3W for a physical product location in a store mapped to a three.word.address. Accept Bitcoin and give the physical product away for free.", 
    img: "socialAds", 
    emoji: "🛍️", // Unique emoji for this service
  },
  { 
    title: "CONTRACT", 
    subtitle: "SMART", 
    description: "We customize the smart contract for W3W based on the specific use case agreed upon when the buyer transfers the payment, which is upheld in a court of law.", 
    img: "webDev", 
    emoji: "✍️", // Unique emoji for this service
  },
  { 
    title: "TIKTOK", 
    subtitle: "PROMO", 
    description: "We promote your W3W on the @CRECLUB TikTok through reels, branded effects, or paid ad campaigns by creating the content for you.", 
    img: "edVideos", 
    emoji: "🎥", // Unique emoji for this service
  },
  { 
    title: "W3WTREE", 
    subtitle: "LINK IN BIO", 
    description: "We united the real estate on the W3Wtree, to showcase CRE CLUB members' properties and display their bios/wallet address and achievements in one link.", 
    img: "seo", 
    emoji: "🔗", // Unique emoji for this service
  },
  { 
    title: "GUIDE", 
    subtitle: "RWA", 
    description: "Once you eliminate the middleman by tokenizing your RWA as a W3W property, we guide members by answering any Bitcoin real estate-related questions.", 
    img: "sem", 
    emoji: "🎤", // Unique emoji for this service
  },
];
---

<head>
  <!-- Add this line to import the Noto Color Emoji font -->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap');
  </style>
</head>

<ContentSection title="NEW ASSET CLASS" id="solutions">
  <Fragment slot="lead">
    <span class="text-primary">W3W</span> properties are the new Bitcoin real estate asset class that anyone, even a 5th grader, can easily
    understand and remember. We solved the problem of Gen-Z selling physical assets passed down to them by offering a digital alternative: the W3W property.
  </Fragment>

  {
    services.map((service, index) => (
      <div class="max-w-6xl">
        {index % 2 === 0 ? (
          <div class="md:flex md:flex-row lg:max-h-[27rem] lg:min-h-[27rem] 2xl:max-h-[35rem]">
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-end md:text-end">
              <h3 class="mb-2 font-semibold text-gris text-lg md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 font-extrabold text-6xl md:mb-7 md:text-4xl">
                {service.title}
              </h2>
              <p class="text-balance font-normal text-gris text-base">
                {service.description}
              </p>
            </div>
            <div class="my-6 justify-center md:my-12 md:w-1/2 flex items-center justify-center">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <!-- Emoji with large size (10x) -->
                <span class="twemoji" style="font-family: 'Noto Color Emoji', sans-serif; font-size: 10rem;">
                  {service.emoji}
                </span>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col-reverse md:flex-row lg:max-h-[27rem] lg:min-h-[27rem] 2xl:max-h-[35rem]">
            <div class="my-6 justify-center md:my-12 md:w-1/2 flex items-center justify-center">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <!-- Emoji with large size (10x) -->
                <span class="twemoji" style="font-family: 'Noto Color Emoji', sans-serif; font-size: 10rem;">
                  {service.emoji}
                </span>
              </div>
            </div>
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-start md:text-start">
              <h3 class="mb-2 font-semibold text-gris text-lg md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 font-extrabold text-6xl md:mb-7 md:text-4xl">
                {service.title}
              </h2>
              <p class="font-normal text-gris text-base">
                {service.description}
              </p>
            </div>
          </div>
        )}
      </div>
    ))
  }
</ContentSection>
