---
import { Icon } from "astro-icon/components";
---

<section class="max-w-[88rem] py-12">
  <div class="container mx-auto px-4">
    <div class="-mx-4 flex flex-wrap gap-10">
      <div
        class="group relative overflow-hidden rounded-lg px-6 pb-8 pt-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl sm:rounded-lg sm:px-10"
      >
        <span
          class="absolute top-10 z-0 h-20 w-20 rounded-full bg-primary transition-all duration-300 group-hover:scale-[15]"
        ></span>
        <div class="relative z-10 mx-auto max-w-md">
          <span
            class="grid h-20 w-20 place-items-center rounded-full bg-primary transition-all duration-300 group-hover:bg-primary"
          >
            <Icon
              class="h-10 w-10 text-white transition-all"
              name={"mdi:shield-account-outline"}
            />
          </span>
          <h2
            class="mt-5 font-bold transition-all duration-300 text-2xl group-hover:text-dark"
          >
            @CRECLUB
          </h2>
          <div
            class="space-y-6 pt-5 leading-7 transition-all duration-300 text-base group-hover:text-dark"
          >
            <p class="text-pretty">
              CRE CLUB TikTok is the fastest growing commercial real estate channel
              that promotes W3W properties in our story for free.
            </p>
          </div>
        </div>
      </div>
      <div
        class="group relative overflow-hidden rounded-lg px-6 pb-8 pt-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl sm:rounded-lg sm:px-10"
      >
        <span
          class="absolute top-10 z-0 h-20 w-20 rounded-full bg-primary transition-all duration-300 group-hover:scale-[15]"
        ></span>
        <div class="relative z-10 mx-auto max-w-md">
          <span
            class="grid h-20 w-20 place-items-center rounded-full bg-primary transition-all duration-300 group-hover:bg-primary"
          >
            <Icon
              class="h-10 w-10 text-white transition-all"
              name={"mdi:eye-outline"}
            />
          </span>
          <h2
            class="mt-5 font-bold transition-all duration-300 text-2xl group-hover:text-dark"
          >
            RWA
          </h2>
          <div
            class="space-y-6 pt-5 leading-7 transition-all duration-300 text-base group-hover:text-dark"
          >
            <p class="text-pretty">
              Each 3 word address is tokenized, representing property ownership, making
              real-world asset (RWA) transactions as simple as possible. 
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>